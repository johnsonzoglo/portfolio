# Public URL used in payment, email, and recovery links.
APP_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0

# Set a long random value in production.
SESSION_SECRET=replace-with-at-least-32-random-characters
MEDIA_SIGNING_SECRET=replace-with-a-different-long-random-value

# Stripe Checkout and webhook signing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email through Resend.
RESEND_API_KEY=
EMAIL_FROM=JZ <hello@your-domain.com>

# Automated full snapshots. Set to 0 to disable.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
